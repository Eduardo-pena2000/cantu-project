{
  "name": "stores-project-backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "tsnd --respawn --clear src/app.ts",
    "dev:docker": "docker-compose -f docker-compose.yml --env-file .env up -d && tsnd --respawn --clear src/app.ts",
    "build": "tsc",
    "start": "node dist/app.js",
    "seeders:generate": "npx sequelize-cli seed:generate --name",
    "seeders:run": "npx sequelize-cli db:seed:all",
    "seeders:one": "npx sequelize-cli db:seed --seed",
    "seeders:revert": "npx sequelize-cli db:seed:undo --seed",
    "seeders:delete": "npx sequelize-cli db:seed:undo:all",
    "migrations:generate": "npx sequelize-cli model:generate --name"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.1",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "sequelize-cli": "^6.6.3",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cloudinary": "^2.6.1",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "env-var": "^7.5.0",
    "express": "^5.1.0",
    "express-validator": "^7.2.1",
    "firebase-admin": "^13.5.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.2",
    "node-cron": "^4.2.1",
    "pg": "^8.15.6",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.7",
    "sharp": "^0.34.1",
    "socket.io": "^4.8.1",
    "uuid": "^11.1.0",
    "zod": "^4.3.6"
  }
}
